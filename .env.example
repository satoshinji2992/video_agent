# Copy to .env and fill in what you need (`npm start` does not read it by itself: run with
# `npx tsx --env-file=.env src/server.ts`, or export the variables). Every variable is optional; the value after
# `=` in the comments is the default. Never commit the real .env.

# --- Claude (the agent's brain) ---
# An Anthropic-compatible endpoint and key. With neither set, the Claude Agent SDK uses this machine's Claude
# Code login.
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=
# Conversation model and reasoning effort (low | medium | high | xhigh | max).
# VIDEO_AGENT_MODEL=claude-opus-5-5
# VIDEO_AGENT_EFFORT=medium
# Models offered in the system panel, as JSON: [{"id":"...","label":"...","note":"..."}].
# VIDEO_AGENT_MODELS=
# Opening line of each turn, written by a short separate call so it shows within seconds; false lets the
# agent write it itself.
# FAST_FIRST_REPLY=true
# OPENER_MODEL=claude-sonnet-4-6
# Background turn reviews and preference-memory upkeep (defaults to VIDEO_AGENT_MODEL).
# REVIEW_MODEL=
# REVIEW_EFFORT=low
# Keep the Claude Code CLI's non-essential network traffic (off by default for faster start-up).
# VIDEO_AGENT_CLI_TRAFFIC=

# --- Seedance (realistic shots) ---
# Without SEEDANCE_API_KEY, realistic shots become placeholder clips and nothing is charged.
# SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SEEDANCE_API_KEY=
# SEEDANCE_MODEL=doubao-seedance-2-5-260628
# Models offered in the system panel, as JSON: [{"id":"...","label":"...","note":"...","maxSeconds":15}].
# SEEDANCE_MODELS=
# SEEDANCE_DRAFT=true
# SEEDANCE_MAX_CONCURRENT=3
# Longest clip the model accepts (30 for Seedance 2.5, otherwise 15).
# SEEDANCE_MAX_SECONDS=
# SEEDANCE_POLL_MS=4000
# SEEDANCE_TIMEOUT_MINUTES=15
# Optional billing lookup: GET <url>?task_id=<id> -> { actual_amount, currency }.
# SEEDANCE_USAGE_URL=
# Force placeholder clips even when a key is set.
# SEEDANCE_MOCK=

# --- Other services through one OpenAI-compatible relay (speech, transcription, search, images) ---
# Default to the origin of SEEDANCE_BASE_URL and to SEEDANCE_API_KEY.
# RELAY_URL=
# RELAY_API_KEY=
# TTS_MODEL=speech-2.8-hd
# Voice catalogue as JSON, keyed by voice key: {"zh_gentle_m":{"id":"...","lang":"zh","gender":"male","label":"...","fits":"..."}}.
# TTS_CATALOG=
# Tavily: web research (search and page extraction) and image search. Without it, research falls back to the relay's
# Gemini / GPT web search and find_web_image only offers App Store icons.
# TAVILY_API_KEY=
# USD per Tavily credit, for the ledger.
# TAVILY_USD_PER_CREDIT=0.008
# RESEARCH_GEMINI_MODEL=gemini-3.5-flash
# RESEARCH_GPT_MODEL=gpt-5.5
# IMAGE_MODEL_GPT=gpt-image-2
# IMAGE_MODEL_SEEDREAM=doubao-seedream-5-0-260128
# Transcription timeout for uploads: base milliseconds, plus 2 s per second of audio.
# INGEST_TRANSCRIBE_TIMEOUT_MS=

# --- Budget (all paid calls together) ---
# BUDGET_LIMIT_USD=100
# BUDGET_WARN_RATIO=0.8
# Claude spend is counted when ANTHROPIC_BASE_URL or ANTHROPIC_API_KEY is set; true/false overrides that.
# BUDGET_COUNT_CLAUDE=
# BUDGET_CLAUDE_TURN_RESERVE_USD=0.5
# Per-conversation cap on Claude spend.
# VIDEO_AGENT_MAX_BUDGET_USD=5
# Prices used when a provider reports no actual charge (replace with your provider's prices).
# SEEDANCE_USD_PER_MTOKEN=9.72
# TTS_USD_PER_1K_CHARS=0.1
# RESEARCH_USD_PER_CALL=0.02
# IMAGE_USD_GPT=0.04
# IMAGE_USD_SEEDREAM=0.03
# CNY per USD, for providers that bill in yuan.
# USD_CNY_RATE=7.2

# --- Output ---
# Videos are 480p. 720p or 1080p only take effect together with ENABLE_HD=true.
# ENABLE_HD=
# VIDEO_RESOLUTION=

# --- Server and storage ---
# PORT=8787
# HOST=127.0.0.1
# DATA_DIR=data
# Installed agent skills (npm run skill:add <git-url>).
# SKILLS_DIR=skills
# CHROME_PATH=/usr/bin/google-chrome
# RENDER_CONCURRENCY=4
# RENDER_3D_CONCURRENCY=1
# Idle conversations are unloaded from memory after this many minutes.
# IDLE_SESSION_MINUTES=30
# Deleted conversations stay restorable for this many days.
# TRASH_DAYS=7
# Size cap of the shared 3D model cache in data/model-cache.
# MODEL_CACHE_MAX_MB=2048

# --- Upload limits (bytes unless noted) ---
# Per file (500 MB), per conversation (3 GB, 200 files), across all conversations (60 GB); uploads are refused
# when less than UPLOAD_MIN_FREE_BYTES (20 GB) of disk is free. Per IP: 2 at a time, 5 GB and 300 files an hour.
# UPLOAD_FILE_BYTES=524288000
# UPLOAD_SESSION_BYTES=3221225472
# UPLOAD_SESSION_FILES=200
# UPLOAD_GLOBAL_BYTES=64424509440
# UPLOAD_MIN_FREE_BYTES=21474836480
# UPLOAD_CHUNK_BYTES=4194304
# UPLOAD_PER_IP_CONCURRENT=2
# UPLOAD_PER_IP_HOURLY_BYTES=5368709120
# UPLOAD_PER_IP_HOURLY_FILES=300
