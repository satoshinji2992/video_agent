# Secrets: only the example file is shared.
.env
.env.*
!.env.example

# Agent skills: our own (video-3d) is tracked; third-party skills are installed with
# `npm run skill:add <git-url>` and stay out of the repo (see README).
skills/*
!skills/video-3d/

# Local reference media (e.g. the Grok reference video in the repo root).
/*.mp4

# Benchmark asset packs: downloaded and unpacked by benchmark/scripts/fetch-packs.sh.
benchmark/packs/*/
benchmark/packs/*.zip

